SECRET_KEY=replace-with-a-long-random-secret
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Leave DATABASE_URL unset to use SQLite locally.
# PostgreSQL example:
# DATABASE_URL=postgresql://postgres:password@localhost:5432/url_shortener

# Set REDIS_URL in production to share rate limits between application workers.
# REDIS_URL=redis://localhost:6379/0

# Only enable these after confirming all subdomains will always use HTTPS.
# SECURE_HSTS_INCLUDE_SUBDOMAINS=True
# SECURE_HSTS_PRELOAD=True
